<Application x:Class="TaskBuddyWPF.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:TaskBuddyWPF"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:conv="clr-namespace:TaskBuddyWPF.Converters"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ui:ThemesDictionary Theme="Dark" />
                <ui:ControlsDictionary />
            </ResourceDictionary.MergedDictionaries>
            <conv:BytesToMbConverter x:Key="BytesToMbConverter"/>
            <conv:BytesPerSecToMBpsConverter x:Key="BytesPerSecToMBpsConverter"/>
            <conv:CpuHeatBrushConverter x:Key="CpuHeatBrushConverter"/>
            <conv:MemoryHeatBrushConverter x:Key="MemoryHeatBrushConverter"/>
            <conv:DiskHeatBrushConverter x:Key="DiskHeatBrushConverter"/>
        </ResourceDictionary>
    </Application.Resources>
</Application>
