<Page x:Class="TaskBuddyWPF.Pages.DetailsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      Loaded="Page_Loaded" x:Name="RootPage">
    <Grid x:Name="RootGrid" Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,12">
            <ui:TextBox x:Name="SearchBox" Width="240" PlaceholderText="Search processes"
                        TextChanged="SearchBox_TextChanged"/>
        </StackPanel>

        <DataGrid Grid.Row="1" x:Name="DetailsGrid" AutoGenerateColumns="False"
                  IsReadOnly="True" CanUserAddRows="False"
                  PreviewMouseRightButtonDown="DetailsGrid_PreviewMouseRightButtonDown">
            <DataGrid.Columns>
                <DataGridTemplateColumn Header="Name" Width="2*">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Image Source="{Binding Icon}" Width="16" Height="16" Margin="0,0,8,0"/>
                                <TextBlock Text="{Binding Name}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="PID" Binding="{Binding Pid}" Width="*"/>
                <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="*"/>
                <DataGridTextColumn Header="User" Binding="{Binding UserName}" Width="1.5*"/>
                <DataGridTextColumn Header="CPU %" Binding="{Binding CpuPercent, StringFormat={}{0:F1}}" Width="*"/>
                <DataGridTextColumn Header="Memory (MB)" Binding="{Binding MemoryBytes, Converter={StaticResource BytesToMbConverter}}" Width="*"/>
                <DataGridTextColumn Header="Architecture" Binding="{Binding Architecture}" Width="*"/>
                <DataGridCheckBoxColumn Header="UAC Virtualization" Binding="{Binding IsVirtualized}" Width="Auto"/>
                <DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="2*"/>
            </DataGrid.Columns>
            <DataGrid.ContextMenu>
                <ContextMenu Opened="DetailsContextMenu_Opened">
                    <MenuItem x:Name="D_SuspendResumeMenuItem" Header="Suspend" Click="D_SuspendResume_Click"/>
                    <MenuItem x:Name="D_EfficiencyModeMenuItem" Header="Efficiency mode" Click="D_EfficiencyMode_Click" IsCheckable="True"/>
                    <MenuItem Header="Set priority">
                        <MenuItem Header="Realtime" Click="D_SetPriority_Click" Tag="Realtime" IsCheckable="True"/>
                        <MenuItem Header="High" Click="D_SetPriority_Click" Tag="High" IsCheckable="True"/>
                        <MenuItem Header="Above normal" Click="D_SetPriority_Click" Tag="AboveNormal" IsCheckable="True"/>
                        <MenuItem Header="Normal" Click="D_SetPriority_Click" Tag="Normal" IsCheckable="True"/>
                        <MenuItem Header="Below normal" Click="D_SetPriority_Click" Tag="BelowNormal" IsCheckable="True"/>
                        <MenuItem Header="Idle" Click="D_SetPriority_Click" Tag="Idle" IsCheckable="True"/>
                    </MenuItem>
                    <MenuItem Header="Set affinity" Click="D_SetAffinity_Click"/>
                    <MenuItem Header="End Task" Click="D_EndTask_Click"/>
                    <MenuItem Header="End process tree" Click="D_EndProcessTree_Click"/>
                    <MenuItem Header="Create dump file" Click="D_CreateDumpFile_Click"/>
                    <Separator/>
                    <MenuItem Header="Open File Location" Click="D_OpenFileLocation_Click"/>
                    <MenuItem Header="Copy PID" Click="D_CopyPid_Click"/>
                    <Separator/>
                    <MenuItem Header="Search online" Click="D_SearchOnline_Click"/>
                    <MenuItem Header="Properties" Click="D_Properties_Click"/>
                    <MenuItem Header="Go to service(s)" Click="D_GoToService_Click"/>
                </ContextMenu>
            </DataGrid.ContextMenu>
        </DataGrid>
    </Grid>
</Page>
