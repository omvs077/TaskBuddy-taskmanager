<Page x:Class="TaskBuddyWPF.Pages.PerformancePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:controls="clr-namespace:TaskBuddyWPF.Controls"
      Title="PerformancePage"
      Loaded="Page_Loaded">
    <Grid x:Name="RootGrid" Margin="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" Margin="0,0,12,0">
        <StackPanel x:Name="SidebarPanel">
            <Border x:Name="CpuCard" Background="#14FFFFFF" CornerRadius="4" Margin="0,0,0,8" Padding="10" Cursor="Hand" MouseLeftButtonUp="CpuCard_Click">
                <StackPanel>
                    <TextBlock Text="CPU" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,4" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                    <controls:PerformanceGraph x:Name="CpuMiniGraph" Height="40"/>
                    <TextBlock x:Name="CpuMiniValue" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>
            <Border x:Name="MemoryCard" Background="#14FFFFFF" CornerRadius="4" Margin="0,0,0,8" Padding="10" Cursor="Hand" MouseLeftButtonUp="MemoryCard_Click">
                <StackPanel>
                    <TextBlock Text="Memory" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,4" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                    <controls:PerformanceGraph x:Name="MemoryMiniGraph" Height="40"/>
                    <TextBlock x:Name="MemoryMiniValue" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>
            <Border x:Name="DiskCard" Background="#14FFFFFF" CornerRadius="4" Margin="0,0,0,8" Padding="10" Cursor="Hand" MouseLeftButtonUp="DiskCard_Click">
                <StackPanel>
                    <TextBlock Text="Disk" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,4" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                    <controls:PerformanceGraph x:Name="DiskMiniGraph" Height="40"/>
                    <TextBlock x:Name="DiskMiniValue" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>
            <Border x:Name="WifiCard" Background="#14FFFFFF" CornerRadius="4" Margin="0,0,0,8" Padding="10" Cursor="Hand" MouseLeftButtonUp="WifiCard_Click">
                <StackPanel>
                    <TextBlock Text="Wi-Fi" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,4" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                    <controls:PerformanceGraph x:Name="WifiMiniGraph" Height="40"/>
                    <TextBlock x:Name="WifiMiniValue" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>
            <Border x:Name="Gpu0Card" Background="#14FFFFFF" CornerRadius="4" Margin="0,0,0,8" Padding="10" Cursor="Hand" MouseLeftButtonUp="Gpu0Card_Click">
                <StackPanel>
                    <TextBlock Text="GPU 0" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,4" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                    <controls:PerformanceGraph x:Name="Gpu0MiniGraph" Height="40"/>
                    <TextBlock x:Name="Gpu0MiniValue" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>
            <Border x:Name="Gpu1Card" Background="#14FFFFFF" CornerRadius="4" Margin="0,0,0,8" Padding="10" Cursor="Hand" MouseLeftButtonUp="Gpu1Card_Click">
                <StackPanel>
                    <TextBlock Text="GPU 1" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,4" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                    <controls:PerformanceGraph x:Name="Gpu1MiniGraph" Height="40"/>
                    <TextBlock x:Name="Gpu1MiniValue" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>
        </StackPanel>
        </ScrollViewer>

        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="320"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Margin="0,0,0,10">
                <TextBlock x:Name="DetailTitle" Text="CPU" FontSize="20" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                <TextBlock x:Name="DetailSubtitle" FontSize="12" Margin="0,2,0,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
            </StackPanel>

            <controls:PerformanceGraph x:Name="DetailGraph" Grid.Row="1"/>

            <Grid x:Name="StatsRow" Grid.Row="2" Margin="0,16,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock x:Name="Stat1Label" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                    <TextBlock x:Name="Stat1Value" FontSize="16" FontWeight="SemiBold" Margin="0,2,0,0" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                </StackPanel>
                <StackPanel Grid.Column="1">
                    <TextBlock x:Name="Stat2Label" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                    <TextBlock x:Name="Stat2Value" FontSize="16" FontWeight="SemiBold" Margin="0,2,0,0" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock x:Name="Stat3Label" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                    <TextBlock x:Name="Stat3Value" FontSize="16" FontWeight="SemiBold" Margin="0,2,0,0" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                </StackPanel>
                <StackPanel Grid.Column="3">
                    <TextBlock x:Name="Stat4Label" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                    <TextBlock x:Name="Stat4Value" FontSize="16" FontWeight="SemiBold" Margin="0,2,0,0" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                </StackPanel>
            </Grid>
        </Grid>
        <StackPanel x:Name="CpuInfoPanel" Grid.Column="2" Margin="16,0,0,0" Width="180" Visibility="Collapsed">
            <StackPanel Margin="0,0,0,10">
                <TextBlock Text="Base speed" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                <TextBlock x:Name="CpuBaseSpeedValue" FontSize="14" FontWeight="SemiBold" Margin="0,2,0,0" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
            </StackPanel>
            <StackPanel Margin="0,0,0,10">
                <TextBlock Text="Sockets" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                <TextBlock x:Name="CpuSocketsValue" FontSize="14" FontWeight="SemiBold" Margin="0,2,0,0" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
            </StackPanel>
            <StackPanel Margin="0,0,0,10">
                <TextBlock Text="Cores" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                <TextBlock x:Name="CpuCoresValue" FontSize="14" FontWeight="SemiBold" Margin="0,2,0,0" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
            </StackPanel>
            <StackPanel Margin="0,0,0,10">
                <TextBlock Text="Logical processors" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                <TextBlock x:Name="CpuLogicalValue" FontSize="14" FontWeight="SemiBold" Margin="0,2,0,0" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
            </StackPanel>
            <StackPanel Margin="0,0,0,10">
                <TextBlock Text="Virtualization" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                <TextBlock x:Name="CpuVirtualizationValue" FontSize="14" FontWeight="SemiBold" Margin="0,2,0,0" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
            </StackPanel>
            <StackPanel Margin="0,0,0,10">
                <TextBlock Text="L1 cache" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                <TextBlock x:Name="CpuL1Value" FontSize="14" FontWeight="SemiBold" Margin="0,2,0,0" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
            </StackPanel>
            <StackPanel Margin="0,0,0,10">
                <TextBlock Text="L2 cache" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                <TextBlock x:Name="CpuL2Value" FontSize="14" FontWeight="SemiBold" Margin="0,2,0,0" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
            </StackPanel>
            <StackPanel>
                <TextBlock Text="L3 cache" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                <TextBlock x:Name="CpuL3Value" FontSize="14" FontWeight="SemiBold" Margin="0,2,0,0" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
            </StackPanel>
        </StackPanel>

        <Grid x:Name="MemInfoPanel" Grid.Column="2" Margin="16,0,0,0" Width="260" Visibility="Collapsed">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <StackPanel Margin="0,0,0,10">
                    <TextBlock Text="In use (Compressed)" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                    <TextBlock x:Name="MemInUseValue" FontSize="14" FontWeight="SemiBold" Margin="0,2,0,0" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                </StackPanel>
                <StackPanel Margin="0,0,0,10">
                    <TextBlock Text="Available" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                    <TextBlock x:Name="MemAvailableValue" FontSize="14" FontWeight="SemiBold" Margin="0,2,0,0" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                </StackPanel>
                <StackPanel Margin="0,0,0,10">
                    <TextBlock Text="Committed" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                    <TextBlock x:Name="MemCommittedValue" FontSize="14" FontWeight="SemiBold" Margin="0,2,0,0" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                </StackPanel>
                <StackPanel Margin="0,0,0,10">
                    <TextBlock Text="Cached" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                    <TextBlock x:Name="MemCachedValue" FontSize="14" FontWeight="SemiBold" Margin="0,2,0,0" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                </StackPanel>
                <StackPanel Margin="0,0,0,10">
                    <TextBlock Text="Paged pool" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                    <TextBlock x:Name="MemPagedPoolValue" FontSize="14" FontWeight="SemiBold" Margin="0,2,0,0" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                </StackPanel>
                <StackPanel>
                    <TextBlock Text="Non-paged pool" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                    <TextBlock x:Name="MemNonPagedPoolValue" FontSize="14" FontWeight="SemiBold" Margin="0,2,0,0" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                </StackPanel>
            </StackPanel>
            <StackPanel Grid.Column="1">
                <StackPanel Margin="0,0,0,10">
                    <TextBlock Text="Speed" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                    <TextBlock x:Name="MemSpeedValue" FontSize="14" FontWeight="SemiBold" Margin="0,2,0,0" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                </StackPanel>
                <StackPanel Margin="0,0,0,10">
                    <TextBlock Text="Slots used" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                    <TextBlock x:Name="MemSlotsValue" FontSize="14" FontWeight="SemiBold" Margin="0,2,0,0" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                </StackPanel>
                <StackPanel Margin="0,0,0,10">
                    <TextBlock Text="Form factor" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                    <TextBlock x:Name="MemFormFactorValue" FontSize="14" FontWeight="SemiBold" Margin="0,2,0,0" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                </StackPanel>
                <StackPanel>
                    <TextBlock Text="Hardware reserved" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                    <TextBlock x:Name="MemHardwareReservedValue" FontSize="14" FontWeight="SemiBold" Margin="0,2,0,0" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                </StackPanel>
            </StackPanel>
        </Grid>

        <StackPanel x:Name="DiskInfoPanel" Grid.Column="2" Margin="16,0,0,0" Width="180" Visibility="Collapsed">
            <StackPanel Margin="0,0,0,10">
                <TextBlock Text="Capacity" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                <TextBlock x:Name="DiskCapacityValue" FontSize="14" FontWeight="SemiBold" Margin="0,2,0,0" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
            </StackPanel>
            <StackPanel Margin="0,0,0,10">
                <TextBlock Text="Formatted size" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                <TextBlock x:Name="DiskFormattedValue" FontSize="14" FontWeight="SemiBold" Margin="0,2,0,0" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
            </StackPanel>
            <StackPanel Margin="0,0,0,10">
                <TextBlock Text="System disk" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                <TextBlock x:Name="DiskSystemValue" FontSize="14" FontWeight="SemiBold" Margin="0,2,0,0" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
            </StackPanel>
            <StackPanel Margin="0,0,0,10">
                <TextBlock Text="Page file" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                <TextBlock x:Name="DiskPageFileValue" FontSize="14" FontWeight="SemiBold" Margin="0,2,0,0" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
            </StackPanel>
            <StackPanel>
                <TextBlock Text="Type" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                <TextBlock x:Name="DiskTypeValue" FontSize="14" FontWeight="SemiBold" Margin="0,2,0,0" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Page>







