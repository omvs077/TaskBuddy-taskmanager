<Page x:Class="TaskBuddyWPF.Pages.PerformancePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:controls="clr-namespace:TaskBuddyWPF.Controls"
      Title="PerformancePage"
      Loaded="Page_Loaded">
    <Grid x:Name="RootGrid" Margin="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <StackPanel x:Name="SidebarPanel" Grid.Column="0" Margin="0,0,12,0">
            <Border x:Name="CpuCard" Background="#14FFFFFF" CornerRadius="4" Margin="0,0,0,8" Padding="10" Cursor="Hand" MouseLeftButtonUp="CpuCard_Click">
                <StackPanel>
                    <TextBlock Text="CPU" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,4" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                    <controls:PerformanceGraph x:Name="CpuMiniGraph" Height="40"/>
                    <TextBlock x:Name="CpuMiniValue" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>
            <Border x:Name="MemoryCard" Background="#14FFFFFF" CornerRadius="4" Margin="0,0,0,8" Padding="10" Cursor="Hand" MouseLeftButtonUp="MemoryCard_Click">
                <StackPanel>
                    <TextBlock Text="Memory" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,4" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                    <controls:PerformanceGraph x:Name="MemoryMiniGraph" Height="40"/>
                    <TextBlock x:Name="MemoryMiniValue" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>
            <Border x:Name="DiskCard" Background="#14FFFFFF" CornerRadius="4" Margin="0,0,0,8" Padding="10" Cursor="Hand" MouseLeftButtonUp="DiskCard_Click">
                <StackPanel>
                    <TextBlock Text="Disk" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,4" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                    <controls:PerformanceGraph x:Name="DiskMiniGraph" Height="40"/>
                    <TextBlock x:Name="DiskMiniValue" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>
        </StackPanel>

        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock x:Name="DetailTitle" Grid.Row="0" Text="CPU" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,10" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>

            <controls:PerformanceGraph x:Name="DetailGraph" Grid.Row="1"/>

            <Grid x:Name="StatsRow" Grid.Row="2" Margin="0,16,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock x:Name="Stat1Label" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                    <TextBlock x:Name="Stat1Value" FontSize="16" FontWeight="SemiBold" Margin="0,2,0,0" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                </StackPanel>
                <StackPanel Grid.Column="1">
                    <TextBlock x:Name="Stat2Label" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                    <TextBlock x:Name="Stat2Value" FontSize="16" FontWeight="SemiBold" Margin="0,2,0,0" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock x:Name="Stat3Label" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                    <TextBlock x:Name="Stat3Value" FontSize="16" FontWeight="SemiBold" Margin="0,2,0,0" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                </StackPanel>
                <StackPanel Grid.Column="3">
                    <TextBlock x:Name="Stat4Label" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                    <TextBlock x:Name="Stat4Value" FontSize="16" FontWeight="SemiBold" Margin="0,2,0,0" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</Page>
