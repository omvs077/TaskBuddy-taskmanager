<Page x:Class="TaskBuddyWPF.Pages.WifiPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:controls="clr-namespace:TaskBuddyWPF.Controls"
      Title="WifiPage"
      Loaded="Page_Loaded">
    <Grid x:Name="RootGrid" Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="320"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,10">
            <TextBlock Text="Wi-Fi" FontSize="20" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
            <TextBlock x:Name="DetailSubtitle" FontSize="12" Margin="0,2,0,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
        </StackPanel>

        <Grid Grid.Row="1" x:Name="ConnectedPanel">
            <controls:PerformanceGraph x:Name="DetailGraph"/>
        </Grid>

        <StackPanel x:Name="DisconnectedPanel" Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="Collapsed">
            <TextBlock Text="No Wi-Fi connection" FontSize="16" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center"/>
        </StackPanel>

        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,10,0,16">
            <Rectangle Width="10" Height="10" Fill="#5AAAFF" RadiusX="2" RadiusY="2" VerticalAlignment="Center"/>
            <TextBlock Text=" Receive" FontSize="11" Margin="0,0,16,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}" VerticalAlignment="Center"/>
            <Rectangle Width="10" Height="2" Fill="Orange" VerticalAlignment="Center"/>
            <TextBlock Text=" Send" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" VerticalAlignment="Center"/>
        </StackPanel>

        <Grid x:Name="StatsGrid" Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,0,16">
                <TextBlock Text="Adapter name" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                <TextBlock x:Name="AdapterNameValue" FontSize="14" FontWeight="SemiBold" Margin="0,2,0,0" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
            </StackPanel>
            <StackPanel Grid.Row="0" Grid.Column="1" Margin="0,0,0,16">
                <TextBlock Text="SSID" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                <TextBlock x:Name="SsidValue" FontSize="14" FontWeight="SemiBold" Margin="0,2,0,0" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
            </StackPanel>
            <StackPanel Grid.Row="0" Grid.Column="2" Margin="0,0,0,16">
                <TextBlock Text="Connection type" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                <TextBlock x:Name="ConnectionTypeValue" FontSize="14" FontWeight="SemiBold" Margin="0,2,0,0" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
            </StackPanel>

            <StackPanel Grid.Row="1" Grid.Column="0">
                <TextBlock Text="IPv4 address" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                <TextBlock x:Name="Ipv4Value" FontSize="14" FontWeight="SemiBold" Margin="0,2,0,0" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
            </StackPanel>
            <StackPanel Grid.Row="1" Grid.Column="1">
                <TextBlock Text="IPv6 address" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                <TextBlock x:Name="Ipv6Value" FontSize="14" FontWeight="SemiBold" Margin="0,2,0,0" Foreground="{DynamicResource TextFillColorPrimaryBrush}" TextTrimming="CharacterEllipsis"/>
            </StackPanel>
            <StackPanel Grid.Row="1" Grid.Column="2">
                <TextBlock Text="Signal strength" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                <StackPanel Orientation="Horizontal" Margin="0,4,0,0" VerticalAlignment="Center">
                    <StackPanel x:Name="SignalBars" Orientation="Horizontal" VerticalAlignment="Bottom"/>
                    <TextBlock x:Name="SignalValue" FontSize="14" FontWeight="SemiBold" Margin="6,0,0,0" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                </StackPanel>
            </StackPanel>
        </Grid>
    </Grid>
</Page>
