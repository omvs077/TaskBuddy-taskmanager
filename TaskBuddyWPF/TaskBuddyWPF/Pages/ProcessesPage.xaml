<Page x:Class="TaskBuddyWPF.Pages.ProcessesPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="ProcessesPage"
      Loaded="Page_Loaded">
    <Grid x:Name="RootGrid" Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
            <Grid Width="260">
                <Border Background="#22FFFFFF" CornerRadius="4" BorderBrush="#33FFFFFF" BorderThickness="1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="&#xE721;" FontFamily="Segoe MDL2 Assets"
                                   Foreground="#99FFFFFF" VerticalAlignment="Center" Margin="8,0,4,0" FontSize="14"/>
                        <Grid Grid.Column="1">
                            <TextBox x:Name="SearchBox"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     Padding="0,6,8,6"
                                     Foreground="White"
                                     CaretBrush="White"
                                     VerticalContentAlignment="Center"
                                     TextChanged="SearchBox_TextChanged"/>
                            <TextBlock x:Name="SearchPlaceholder" Text="Search processes..."
                                       Foreground="#66FFFFFF" VerticalAlignment="Center"
                                       Margin="2,0,0,0" IsHitTestVisible="False"/>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>

            <Button Content="Run new task" Margin="10,0,0,0" Padding="10,6" Click="RunNewTask_Click"/>
            <Button Content="End task" Margin="8,0,0,0" Padding="10,6" Click="EndTask_Click"/>

            <Button x:Name="ColumnsButton" Content="Columns" Margin="8,0,0,0" Padding="10,6" Click="ColumnsButton_Click"/>
            <Popup x:Name="ColumnsPopup" PlacementTarget="{Binding ElementName=ColumnsButton}"
                   Placement="Bottom" StaysOpen="False">
                <Border Background="#FF2B2B2B" BorderBrush="#33FFFFFF" BorderThickness="1" CornerRadius="4" Padding="10">
                    <StackPanel>
                        <CheckBox x:Name="ColPidCheck" Content="PID" IsChecked="True" Margin="0,4" Checked="ColumnCheck_Changed" Unchecked="ColumnCheck_Changed"/>
                        <CheckBox x:Name="ColStatusCheck" Content="Status" IsChecked="True" Margin="0,4" Checked="ColumnCheck_Changed" Unchecked="ColumnCheck_Changed"/>
                        <CheckBox x:Name="ColCpuCheck" Content="CPU %" IsChecked="True" Margin="0,4" Checked="ColumnCheck_Changed" Unchecked="ColumnCheck_Changed"/>
                        <CheckBox x:Name="ColMemoryCheck" Content="Memory (MB)" IsChecked="True" Margin="0,4" Checked="ColumnCheck_Changed" Unchecked="ColumnCheck_Changed"/>
                        <CheckBox x:Name="ColDiskCheck" Content="Disk (MB/s)" IsChecked="True" Margin="0,4" Checked="ColumnCheck_Changed" Unchecked="ColumnCheck_Changed"/>
                    </StackPanel>
                </Border>
            </Popup>
        </StackPanel>

        <DataGrid x:Name="ProcessGrid"
                  Grid.Row="1"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  GridLinesVisibility="None"
                  PreviewMouseRightButtonDown="ProcessGrid_PreviewMouseRightButtonDown">
            <DataGrid.Columns>
                <DataGridTemplateColumn Header="Name" Width="2*">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Image Source="{Binding Icon}" Width="16" Height="16" Margin="0,0,8,0"/>
                                <TextBlock Text="{Binding ImageName}" VerticalAlignment="Center"/>
                                <Path Data="M0,7 C0,3 4,0 9,0 C9,5 6.5,7 4.5,7 C6.5,7 9,9 9,13 C4,13 0,11 0,7 Z"
                                      Fill="#4CAF50" Width="9" Height="13" Stretch="Uniform" Margin="6,0,0,0"
                                      VerticalAlignment="Center" ToolTip="Efficiency mode"
                                      Visibility="{Binding IsEfficiencyMode, Converter={StaticResource BoolToVisibilityConverter}}"/>
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn x:Name="PidColumn" Header="PID" Binding="{Binding Pid}" Width="*"/>
                <DataGridTextColumn x:Name="StatusColumn" Header="Status" Binding="{Binding StatusText}" Width="*"/>
                <DataGridTextColumn x:Name="CpuColumn" Header="CPU %" Binding="{Binding CpuPercent, StringFormat={}{0:F1}}" Width="*">
                    <DataGridTextColumn.CellStyle>
                        <Style TargetType="DataGridCell">
                            <Setter Property="Background" Value="{Binding CpuPercent, Converter={StaticResource CpuHeatBrushConverter}}"/>
                        </Style>
                    </DataGridTextColumn.CellStyle>
                </DataGridTextColumn>
                <DataGridTextColumn x:Name="MemoryColumn" Header="Memory (MB)" Binding="{Binding WorkingSetBytes, Converter={StaticResource BytesToMbConverter}}" Width="*">
                    <DataGridTextColumn.CellStyle>
                        <Style TargetType="DataGridCell">
                            <Setter Property="Background" Value="{Binding WorkingSetBytes, Converter={StaticResource MemoryHeatBrushConverter}}"/>
                        </Style>
                    </DataGridTextColumn.CellStyle>
                </DataGridTextColumn>
                <DataGridTextColumn x:Name="DiskColumn" Header="Disk (MB/s)" Binding="{Binding DiskBytesPerSec, Converter={StaticResource BytesPerSecToMBpsConverter}}" Width="*">
                    <DataGridTextColumn.CellStyle>
                        <Style TargetType="DataGridCell">
                            <Setter Property="Background" Value="{Binding DiskBytesPerSec, Converter={StaticResource DiskHeatBrushConverter}}"/>
                        </Style>
                    </DataGridTextColumn.CellStyle>
                </DataGridTextColumn>
            </DataGrid.Columns>
            <DataGrid.ContextMenu>
                <ContextMenu Opened="ContextMenu_Opened">
                    <MenuItem x:Name="SuspendResumeMenuItem" Header="Suspend" Click="SuspendResume_Click"/>
                    <MenuItem x:Name="EfficiencyModeMenuItem" Header="Efficiency mode" Click="EfficiencyMode_Click" IsCheckable="True"/>
                    <MenuItem Header="End Task" Click="EndTask_Click"/>
                    <Separator/>
                    <MenuItem Header="Open File Location" Click="OpenFileLocation_Click"/>
                    <MenuItem Header="Copy PID" Click="CopyPid_Click"/>
                    <Separator/>
                    <MenuItem Header="Search online" Click="SearchOnline_Click"/>
                    <MenuItem Header="Properties" Click="Properties_Click"/>
                    <MenuItem Header="Go to details" Click="GoToDetails_Click"/>
                    <MenuItem x:Name="GoToServiceMenuItem" Header="Go to service(s)" Click="GoToService_Click"/>
                </ContextMenu>
            </DataGrid.ContextMenu>
        </DataGrid>
    </Grid>
</Page>
