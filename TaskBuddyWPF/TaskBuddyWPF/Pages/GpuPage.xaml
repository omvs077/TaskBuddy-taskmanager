<Page x:Class="TaskBuddyWPF.Pages.GpuPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="GpuPage">
    <Grid x:Name="RootGrid" Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="GPU" FontSize="20" FontWeight="SemiBold"
                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" Margin="0,0,0,10"/>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="GpuList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="#14FFFFFF" CornerRadius="4" Padding="12" Margin="0,0,0,10">
                            <StackPanel>
                                <TextBlock Text="{Binding AdapterName}" FontWeight="SemiBold" FontSize="14"
                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}" Margin="0,0,0,10"/>

                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Utilization" FontSize="12" VerticalAlignment="Center"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,10,0"/>
                                    <Border Grid.Column="1" Background="#14FFFFFF" CornerRadius="3" Height="10" VerticalAlignment="Center">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="{Binding UtilizationPercent, Converter={StaticResource PercentToStarWidthConverter}}"/>
                                                <ColumnDefinition Width="{Binding UtilizationPercent, Converter={StaticResource PercentToStarWidthConverter}, ConverterParameter=invert}"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0" Background="#5AAAFF" CornerRadius="3"/>
                                        </Grid>
                                    </Border>
                                    <TextBlock Grid.Column="2" Text="{Binding UtilizationPercent, StringFormat={}{0:F0}%}" FontSize="12" FontWeight="SemiBold"
                                               VerticalAlignment="Center" Margin="10,0,0,0" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                </Grid>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Dedicated GPU memory" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                        <TextBlock Text="{Binding DedicatedUsedBytes, Converter={StaticResource BytesToMbConverter}, StringFormat={}{0} MB}"
                                                   FontSize="14" FontWeight="SemiBold" Margin="0,2,0,0" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="Shared GPU memory" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                        <TextBlock Text="{Binding SharedUsedBytes, Converter={StaticResource BytesToMbConverter}, StringFormat={}{0} MB}"
                                                   FontSize="14" FontWeight="SemiBold" Margin="0,2,0,0" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</Page>
