<Page x:Class="TaskBuddyWPF.Pages.SettingsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Settings">
    <Grid Margin="24">
        <StackPanel MaxWidth="600" HorizontalAlignment="Left">
            <TextBlock Text="Settings" FontSize="24" FontWeight="Bold" Margin="0,0,0,20"
                       Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>

            <TextBlock Text="Processes" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8"
                       Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
            <CheckBox x:Name="ShowIdleProcessCheck" Content="Show System Idle Process (PID 0) in the Processes tab"
                      Checked="ShowIdleProcess_Changed" Unchecked="ShowIdleProcess_Changed"
                      Margin="0,0,0,4"/>
            <TextBlock Text="Takes effect the next time you open the Processes tab."
                       FontSize="12" Margin="24,0,0,20"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>

            <Separator Margin="0,8,0,20"/>

            <TextBlock Text="Performance" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8"
                       Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                <TextBlock Text="Refresh speed:" VerticalAlignment="Center" Margin="0,0,10,0"
                           Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                <ComboBox x:Name="RefreshSpeedCombo" Width="140" SelectionChanged="RefreshSpeed_Changed">
                    <ComboBoxItem Content="Fast (1s)" Tag="1"/>
                    <ComboBoxItem Content="Normal (2s)" Tag="2"/>
                    <ComboBoxItem Content="Slow (5s)" Tag="5"/>
                </ComboBox>
            </StackPanel>
            <TextBlock Text="Takes effect the next time you open a live-updating tab. Applies to Processes, Performance, Users, Details, and Services (Services always runs 3x slower than the others)."
                       FontSize="12" TextWrapping="Wrap" Margin="0,0,0,20"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>

            <Separator Margin="0,8,0,20"/>

            <TextBlock Text="About" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8"
                       Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
            <TextBlock Text="TaskBuddy" FontSize="14" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
            <TextBlock x:Name="VersionText" FontSize="12" Margin="0,2,0,0"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
            <TextBlock Text="Dvvyom Labs" FontSize="12" Margin="0,2,0,0"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
            <TextBlock Text="A lightweight, native task manager for Windows." FontSize="12" Margin="0,4,0,0"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
        </StackPanel>
    </Grid>
</Page>
