<Page x:Class="TaskBuddyWPF.Pages.ServicesPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="ServicesPage"
      Loaded="Page_Loaded">
    <Grid x:Name="RootGrid" Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
            <Grid Width="260">
                <Border Background="#22FFFFFF" CornerRadius="4" BorderBrush="#33FFFFFF" BorderThickness="1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="&#xE721;" FontFamily="Segoe MDL2 Assets"
                                   Foreground="#99FFFFFF" VerticalAlignment="Center" Margin="8,0,4,0" FontSize="14"/>
                        <Grid Grid.Column="1">
                            <TextBox x:Name="SearchBox"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     Padding="0,6,8,6"
                                     Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                     CaretBrush="{DynamicResource TextFillColorPrimaryBrush}"
                                     VerticalContentAlignment="Center"
                                     TextChanged="SearchBox_TextChanged"/>
                            <TextBlock x:Name="SearchPlaceholder" Text="Search services..."
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" VerticalAlignment="Center"
                                       Margin="2,0,0,0" IsHitTestVisible="False"/>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>

            <Button Content="Open Services" Margin="10,0,0,0" Padding="10,6" Click="OpenServices_Click"/>
        </StackPanel>

        <DataGrid x:Name="ServiceGrid"
                  Grid.Row="1"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  GridLinesVisibility="None"
                  PreviewMouseRightButtonDown="ServiceGrid_PreviewMouseRightButtonDown">
            <DataGrid.Columns>
                <DataGridTemplateColumn Header="Name" Width="2.5*">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Image Source="{Binding Icon}" Width="16" Height="16" Margin="0,0,8,0"/>
                                <TextBlock Text="{Binding DisplayName}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="Service Name" Binding="{Binding ServiceName}" Width="1.5*"/>
                <DataGridTextColumn Header="PID" Binding="{Binding PidText}" Width="*"/>
                <DataGridTextColumn Header="Status" Binding="{Binding StatusText}" Width="*"/>
                <DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="3*"/>
                <DataGridTextColumn Header="Group" Binding="{Binding Group}" Width="*"/>
            </DataGrid.Columns>
            <DataGrid.ContextMenu>
                <ContextMenu Opened="ContextMenu_Opened">
                    <MenuItem x:Name="StartStopMenuItem" Header="Start" Click="StartStop_Click"/>
                </ContextMenu>
            </DataGrid.ContextMenu>
        </DataGrid>
    </Grid>
</Page>
